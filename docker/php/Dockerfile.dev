# ─────────────────────────────────────────────────────────────────────────────
# Development Dockerfile — PHP 8.4 + Node 22 dalam satu image
# Semua deps (termasuk devDependencies) diinstall untuk hot-reload & debugging
# ─────────────────────────────────────────────────────────────────────────────
FROM php:8.4-fpm-alpine

# Install system dependencies (termasuk Node untuk Vite HMR)
RUN apk add --no-cache \
    bash \
    git \
    curl \
    libpng-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    unzip \
    oniguruma-dev \
    nodejs \
    npm

# Install PHP extensions (MySQL + phpredis untuk pub/sub notifikasi SSE)
RUN docker-php-ext-install \
    pdo \
    pdo_mysql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip \
    opcache \
 && apk add --no-cache --virtual .phpize-deps $PHPIZE_DEPS \
 && pecl install redis \
 && docker-php-ext-enable redis \
 && apk del .phpize-deps

# Nonaktifkan OPcache validate_timestamps di dev agar tidak perlu restart
RUN { \
    echo "opcache.enable=1"; \
    echo "opcache.memory_consumption=128"; \
    echo "opcache.max_accelerated_files=10000"; \
    echo "opcache.validate_timestamps=1"; \
    echo "opcache.revalidate_freq=0"; \
    } >> /usr/local/etc/php/conf.d/opcache.ini

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Pool php-fpm kustom: listen di 0.0.0.0:9000 agar dapat dijangkau nginx
# (container lain), plus kapasitas untuk koneksi SSE berumur panjang.
COPY docker/php/php-fpm.conf /usr/local/etc/php-fpm.d/www.conf

WORKDIR /var/www

EXPOSE 9000

CMD ["php-fpm"]
