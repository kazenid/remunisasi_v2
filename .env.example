APP_NAME=TUKIMAN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=remunisasi_v2
DB_USERNAME=root
DB_PASSWORD=

# SIKEP (bangil_kepegawaian) — READ ONLY source database
SIKEP_DB_HOST=10.20.1.116
SIKEP_DB_PORT=2651
SIKEP_DB_DATABASE=bangil_kepegawaian
SIKEP_DB_USERNAME=ws_sikep
SIKEP_DB_PASSWORD=
SIKEP_DB_CHARSET=latin1
SIKEP_DB_COLLATION=latin1_swedish_ci
# Salt verifikasi password SIKEP: md5(SALT_1 . md5(password) . SALT_2)
# Nilai nyata SIKEP RSUD Bangil: SALT_1=cba654, SALT_2 kosong
SIKEP_PASS_SALT_1=cba654
SIKEP_PASS_SALT_2=
# Base URL foto pegawai SIKEP: {SIKEP_FOTO_BASE_URL}/{token_pegawai}.jpg
SIKEP_FOTO_BASE_URL=https://sikep.rsudbangil.pasuruankab.go.id/foto

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Realtime notifications (SSE + Redis pub/sub) ───
# Koneksi Redis TERDEDIKASI untuk subscribe/publish notifikasi (lepas dari cache/session).
REDIS_NOTIFY_DB=2
# Interval heartbeat SSE (detik). Read-timeout subscribe loop TETAP 1 dtk (konstanta loop).
SSE_HEARTBEAT_SECONDS=20
# Produksi (app di Docker, Redis+MySQL di host): arahkan REDIS_HOST ke host.
# Linux Docker: tambahkan `extra_hosts: host.docker.internal:host-gateway` di compose,
# atau set REDIS_HOST ke IP host.
# REDIS_HOST=host.docker.internal
#
# Catatan dev Windows: di `php artisan serve` (single-proses) SSE sengaja tidak
# tersambung dan memakai fallback polling ~60 dtk; titik merah tetap bekerja.
# SSE end-to-end diuji di stack Docker (nginx + php-fpm).

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile (CAPTCHA halaman login). Kosongkan untuk menonaktifkan.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
